# Jellyfin Caching Proxy — Configuration
# Copy this to .env and fill in your values

# ── Required ────────────────────────────────────────────────────────────────

# URL of your main (remote) Jellyfin server
JELLYFIN_REMOTE_URL=https://jellyfin.example.com

# API key from your remote Jellyfin (Dashboard → API Keys → + )
JELLYFIN_REMOTE_API_KEY=your_api_key_here

# Your Jellyfin user ID (Dashboard → Users → click your user → copy the UUID from the URL)
JELLYFIN_REMOTE_USER_ID=your_user_id_here

# ── Optional ────────────────────────────────────────────────────────────────

# Where to store cached media files on the local server
JELLYFIN_CACHE_DIR=/mnt/jellyfin-cache

# Host user/group IDs used by Docker Compose so the container can write
# to bind-mounted cache directories.
HOST_UID=1000
HOST_GID=1000

# Maximum cache size in GB (0 = unlimited)
JELLYFIN_CACHE_MAX_GB=0

# Port the proxy listens on (should match what your TV connects to)
JELLYFIN_PROXY_PORT=8096

# How often to prefetch next-up / continue-watching (seconds)
JELLYFIN_PREFETCH_INTERVAL_SECONDS=3600

# Max simultaneous downloads (keep at 1 to avoid hammering your connection)
JELLYFIN_MAX_CONCURRENT_DOWNLOADS=1

# Keep at 0 for best playback stability on most clients. Set to 1 only if you
# explicitly want HLS segments generated locally from cached files.
JELLYFIN_ENABLE_LOCAL_HLS_TRANSCODE=0

# Time in seconds after last access before a local HLS FFmpeg session is
# stopped and cleaned up.
JELLYFIN_LOCAL_HLS_SESSION_TTL_SECONDS=300

# Set to 1 to use Nvidia acceleration in local HLS transcode sessions.
JELLYFIN_LOCAL_HLS_USE_NVIDIA=0

# Optional Nvidia runtime selection when using compose.nvidia.yaml
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=video,utility,compute

# Evict cached file N hours after it's been fully watched (0 = keep forever)
JELLYFIN_EVICT_AFTER_WATCHED_HOURS=24

# Comma-separated list of usernames or user IDs to prefetch and evict-check for.
# Leave empty to include ALL users (default). Use this to exclude service accounts
# or users who shouldn't influence what gets cached.
# Example: JELLYFIN_PREFETCH_USERS=Alice,Bob
JELLYFIN_PREFETCH_USERS=
